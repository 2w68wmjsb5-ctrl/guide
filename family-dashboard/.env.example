# Kopieren nach .env und ausfüllen. Diese Datei NIE committen.

# Bring! Einkaufsliste
BRING_EMAIL=
BRING_PASSWORD=
# Name der Liste (leer = erste Liste)
BRING_LIST=Zuhause

# TimeTree (inoffizieller Zugang über timetree-exporter)
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
# Kalender-Code(s), kommagetrennt. Leer = alle aktiven Kalender.
TIMETREE_CALENDAR_CODES=

# Weitere Kalender als iCal-Links (z. B. Müllabfuhr, Schulferien), kommagetrennt
EXTRA_ICS_URLS=

# Optionaler Passwortschutz (HTTP Basic Auth). Leer = kein Schutz.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# true = Beispieldaten statt echter Quellen (zum Ausprobieren)
DEMO=false
